{
  "name": "ttrpg-tools-shell",
  "version": "0.1.0",
  "private": true,
  "description": "TTRPG-Tools — Huelle, in die die einzelnen Werkzeuge eingebettet werden",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/build-tests.mjs && node --test tests/*.test.mjs",
    "smoke": "npm run build && xvfb-run -a electron scripts/smoke.cjs --no-sandbox"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "author": {
    "name": "ItsLunasDream"
  },
  "license": "AGPL-3.0-or-later"
}
