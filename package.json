{
  "name": "dnd-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Werkzeugsammlung fuer D&D-Kampagnen — Workspace-Wurzel",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/backstory",
    "dev:shell": "npm run dev -w apps/shell",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w apps/backstory",
    "start:shell": "npm run start -w apps/shell",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke -w apps/backstory",
    "smoke:shell": "npm run build && npm run smoke -w apps/shell",
    "roundtrip": "npm run roundtrip -w apps/backstory",
    "icon": "npm run icon -w apps/backstory",
    "dist:win": "npm run dist:win -w apps/backstory",
    "dist:linux": "npm run dist:linux -w apps/backstory",
    "dist:linux:dir": "npm run dist:linux:dir -w apps/backstory",
    "verify:package": "npm run verify:package -w apps/backstory",
    "dev:mapmaker": "npm run dev -w apps/mapmaker"
  },
  "author": {
    "name": "ItsLunasDream"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.63.1"
  }
}
